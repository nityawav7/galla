# Copy to .env.local for local development. Never commit real secrets.
# Every variable here is validated in src/lib/env.ts.

# Postgres. Local: `pnpm db:up` starts Docker Postgres 16 on port 5432.
# Neon: use the pooled connection string (host ends in .neon.tech, sslmode=require).
DATABASE_URL=postgres://galla:galla@localhost:5432/galla

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Better Auth session signing secret, at least 32 characters. Generate one with:
#   openssl rand -base64 32
# Use a different value in every environment. This one is for local dev only.
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# Public origin of the app. On Vercel it falls back to VERCEL_URL.
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional; the button is hidden unless both are set).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application),
# redirect URI <origin>/api/auth/callback/google.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Resend (optional locally: without a key, sign-in codes are printed in the dev server log).
# EMAIL_FROM defaults to Resend's shared sender, which only reaches the Resend account owner.
# RESEND_API_KEY=
# EMAIL_FROM="Galla <onboarding@resend.dev>"

# Upstash Redis for rate limits (required in production; in-memory otherwise).
# The Vercel Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN, which also work.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Set automatically on Vercel; leave unset locally.
# VERCEL_ENV=
# VERCEL_GIT_COMMIT_SHA=
# VERCEL_URL=
# VERCEL_BRANCH_URL=
# VERCEL_PROJECT_PRODUCTION_URL=

# Set to 1 to skip env validation (lint/build jobs in CI only).
# SKIP_ENV_VALIDATION=

# Daily job (/api/cron/daily). Vercel Cron sends it as "Authorization: Bearer <value>".
# Without it the route answers 503. Generate with: openssl rand -base64 32
# CRON_SECRET=
