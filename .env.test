# Loaded by tests (NODE_ENV=test). Local Docker credentials only, not secrets.
# CI overrides DATABASE_URL with its own Postgres service.
DATABASE_URL=postgres://galla:galla@localhost:5432/galla_test
LOG_LEVEL=silent
# Test-only auth secret (low entropy on purpose; never used outside tests).
BETTER_AUTH_SECRET=test-secret-test-secret-test-secret-test
BETTER_AUTH_URL=http://localhost:3000
